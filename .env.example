# Copy to `.env.local` for local dev (never commit real secrets).
# Production: set the same keys in Vercel → Project → Settings → Environment Variables.

# -----------------------------------------------------------------------------
# Ops alerts (optional) — fired on coach application updates and draft governance events.
# If both are unset, `notifyOpsEvent` in lib/ops-alerts.ts does nothing (no outbound HTTP).
#
# You must supply real URLs yourself (n8n Webhook node, or any HTTPS endpoint that
# forwards to Discord / OpenClaw / etc.). Do not commit live URLs with secrets in paths.
#
# N8N_WEBHOOK_URL=
# Example: https://aab-n8n.moodmnky.com/webhook/<webhook-id>
# In n8n: workflow must be ACTIVE; Webhook node HTTP method must be POST (app sends JSON).
#
# OPENCLAW_ALERT_WEBHOOK_URL=
# Optional second sink: e.g. small bridge that posts to a staff channel or OpenClaw.
# Not the OpenClaw MCP gateway URL — a plain POST webhook you control.
#
# Payload (JSON POST): { event, source: "poke-mnky", ts, ... }
# Events: coach_application_status, draft_session_pending_admin_approval,
#         draft_session_governance_approved
# -----------------------------------------------------------------------------

N8N_WEBHOOK_URL=
OPENCLAW_ALERT_WEBHOOK_URL=

# League sheet sync (names only; set values in Vercel, never commit them).
# Share the sheet with the service account email as a viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
CRON_SECRET=

# -----------------------------------------------------------------------------
# In-app AI (OpenClaw gateway — primary when URL, agent id, and auth are all set)
# There is no default host or agent id. Leave OPENCLAW_GATEWAY_URL empty to fail closed.
# Do not point production at unrepaired aab-openclaw.moodmnky.com or the operator pilot Claw.
# AI_CHAT_PROVIDER=sources-only keeps chat off OpenClaw while sources-only knowledge stays on.
#
# Member league chat (Cloudflare Access service token; do not send a gateway bearer):
# OPENCLAW_GATEWAY_URL=https://aab-chat-gw.moodmnky.com
# OPENCLAW_AGENT_ID=aab-member
# OPENCLAW_CF_ACCESS_CLIENT_ID=
# OPENCLAW_CF_ACCESS_CLIENT_SECRET=
# OPENCLAW_ALLOWED_AGENT_ID=   # optional. When set in cf-access mode, agent id must match or chat stays off.
# OPENCLAW_MAX_TOKENS=800      # clamped to 1..800
# OPENCLAW_TIMEOUT_MS=60000
# AI_CHAT_MAX_MESSAGE_CHARS=2000
# AI_CHAT_MAX_HISTORY=10
# AI_CHAT_LIMIT_PER_HOUR=20
# AI_CHAT_LIMIT_PER_DAY=100
# AI_CHAT_LIMIT_GLOBAL_PER_DAY=300
#
# Legacy token mode (WebSocket / bearer). Not used by the Access path:
# OPENCLAW_GATEWAY_TOKEN=   # gateway.auth.token (operator.write), NOT hooks.token / OPENCLAW_HOOKS_TOKEN
# OPENCLAW_CLIENT_ID=webchat-ui
# OPENCLAW_CLIENT_MODE=webchat
# OPENCLAW_GATEWAY_INSECURE_SKIP_TLS_VERIFY=true   # local dev only (Norton/SSL inspection)
# AI_CHAT_PROVIDER=sources-only   # or openai | openclaw (openclaw requires non-empty GATEWAY_URL)
# OPENAI_API_KEY=             # optional. Production leaves this unset (owner decision, 2026-11-25).
#                             # OpenAI-only routes (parse-result, weekly recap, draft-board analysis,
#                             # SQL generation, AI battle moves) return HTTP 503. League chat stays on OpenClaw.
# OPENCLAW_HTTP_CHAT=false    # token mode only. cf-access always uses HTTPS /v1/chat/completions.
# Debug: GET /api/openclaw/health  (reports authMode and enabled; cf-access does not call upstream)
#
# Operator Claw web_fetch → bot APIs (GET query auth). Prefer headers for Edge/bot hosts.
# CLAW_WEB_FETCH_BRIDGE=true
#
# MCP tool mode for in-app assistants (draft pool MCP). Default OFF.
# Set true only when MCP_DRAFT_POOL_SERVER_URL + MCP_API_KEY are configured.
AI_MCP_TOOLS_ENABLED=
MCP_DRAFT_POOL_SERVER_URL=
MCP_API_KEY=
# -----------------------------------------------------------------------------

# Legacy Notion draft sync after each pick (off by default). In-app ops: docs/DRAFT-IN-APP-OPERATIONS.md
# DRAFT_PUSH_TO_NOTION=true

# Discord bot → app match submit (parse-result) without user session
# DISCORD_BOT_INTERNAL_SECRET=generate-a-long-random-string
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_RESULTS_CHANNEL_ID=
# DISCORD_VIDEO_CHANNEL_ID=
# DISCORD_RECAP_CHANNEL_ID=
# DISCORD_MOD_CHANNEL_ID=
# DISCORD_MOD_DIGEST_ENABLED=false

# -----------------------------------------------------------------------------
# Legacy Mock Draft Demo /admin/simulation writers (first cutover gate)
# Default OFF / unset = fail closed (HTTP 410) before any DB write.
# Do NOT set true in ordinary production deploys. Coordinator-approved emergency only.
# SIM_LEGACY_SIMULATION_WRITES=
# Optional n8n→full-run key (auth only; gate still applies first):
# SIMULATION_API_KEY=
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Notion -> app pull sync (draft board etc.) — default OFF / unset = fail closed (HTTP 410).
# The app is the source of truth; app -> Notion pick push is NOT affected by this flag.
# When enabled, POST /api/webhooks/notion still requires NOTION_WEBHOOK_SECRET and a valid
# x-notion-signature header.
# NOTION_PULL_SYNC_ENABLED=
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Showdown identity (Phase 0) — server-only (never NEXT_PUBLIC_*)
# Legacy parallel loginserver auto-registration — default OFF (HTTP 410).
# Does NOT verify central Main accounts or import teams. Coordinator-only re-enable.
# SHOWDOWN_LEGACY_LOGINSERVER_SYNC=
# Central OAuth client id (Phase 2). Alone does NOT enable linking; code gate
# SHOWDOWN_OAUTH_LINK_IMPLEMENTED must also be true after OAuth routes ship.
# SHOWDOWN_OAUTH_CLIENT_ID=
# Phase 1 public-replay archive ingest — default OFF (HTTP 410). Server-only.
# REPLAY_INGEST_ENABLED=
#
# Public hosts (defaults when unset). Retired aab-play / aab-calc / aab-replay
# values are ignored by lib/showdown/public-hosts.ts so the app stays usable.
# NEXT_PUBLIC_SHOWDOWN_CLIENT_URL=https://play.pokemonshowdown.com
# NEXT_PUBLIC_SHOWDOWN_REPLAY_URL=https://replay.pokemonshowdown.com
# NEXT_PUBLIC_DAMAGE_CALC_URL=https://calc.pokemonshowdown.com
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Cursor: poke-mnky-n8n MCP (workflow list/get/edit — NOT the webhook above)
# Create a key in n8n: Settings → API → Create API Key.
# Point `.cursor/mcp.json` at these via "env": { "N8N_API_KEY": "${env:N8N_API_KEY}", ... }
# Restart Cursor after changing MCP env.
#
# N8N_API_URL=https://aab-n8n.moodmnky.com
# N8N_API_KEY=n8n_api_...
#
# n8n workflow builders reference an n8n "Header Auth" credential by id; secrets are
# never embedded in workflow JSON. Create the credential in the n8n UI (header
# `Authorization`, value `Bearer <NOTION_SYNC_SECRET from Vercel>`), then set its id here.
# N8N_NOTION_SYNC_CREDENTIAL_ID=
# N8N_NOTION_SYNC_CREDENTIAL_NAME=POKE MNKY Notion Sync Bearer
# Simulation trigger workflow (Header Auth, header `X-Simulation-API-Key`):
# N8N_SIMULATION_CREDENTIAL_ID=
# N8N_SIMULATION_CREDENTIAL_NAME=POKE MNKY Simulation API Key
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Jev pilot (TypeSafe System One) — offline harness only (pnpm jev:pilot).
# Provider preference when credentials present: Vercel AI Gateway → OpenRouter → TypeSafe.
# Empty values only; never commit secrets.
#
# (1) Vercel AI Gateway — https://ai-gateway.vercel.sh/typesafe — model typesafe-ai/jev
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # set automatically on Vercel; local via `vercel env pull`
# (2) OpenRouter — https://openrouter.ai/api (/v1/systemone) — model typesafe/jev-1.13
OPENROUTER_API_KEY=
# (3) TypeSafe direct — https://api.typesafe.ai (/v1/systemone) — model jev-1.13.0
TYPESAFE_API_KEY=
# Legacy alias for TypeSafe direct (optional):
# JEV_API_KEY=
# Optional overrides:
# JEV_PROVIDER=vercel-ai-gateway
# JEV_MODEL=
# JEV_BASE_URL=
# App util lib/ai/jev.ts (NOT wired to live routes):
JEV_FLAGS_ENABLED=
# -----------------------------------------------------------------------------
# Season simulator foundation (P0–P1) — all OFF by default
# SIM_SANDBOX_V2=true                 # enable /api/admin/simulation/runs/*
# SIM_WORKER_TICK_ENABLED=true        # enable worker tick HTTP + scripts/sim-worker/tick.ts
# SIM_LEGACY_SIMULATION_WRITES=true   # emergency only: re-enable Mock Draft Demo mutation routes
# SIMULATION_WORKER_KEY=              # preferred worker auth for tick (sandbox ops only)
# SIMULATION_API_KEY=                 # legacy full-run key; also accepted for worker tick if WORKER_KEY unset
# APP_BASE_URL=http://127.0.0.1:3000  # for scripts/sim-worker/tick.ts
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# NetBird automated battle-network onboarding — OFF by default
# Kill switch: anything other than the exact string "true" means OFF. When OFF, the NetBird guide page and the
# Discord bot say onboarding is paused and the onboarding Worker is never called.
NETBIRD_ONBOARDING_ENABLED=false
# HTTPS URL of the Cloudflare Worker `aab-netbird-onboard` (no trailing slash). The Worker holds the NetBird API key
# and the Discord bot token; this app never sees them.
NETBIRD_ONBOARD_WORKER_URL=
# Shared HMAC-SHA256 secret used to sign requests to the Worker. Must equal the Worker's secret of the same name.
# Generate with: openssl rand -base64 32
NETBIRD_ONBOARD_SIGNING_SECRET=
# Discord /join-battles: the only server where the command works (all other servers and DMs are refused).
# The league server id is 1190512330556063764. Left empty here on purpose: when unset, the command refuses everyone.
DISCORD_LEAGUE_GUILD_ID=
# Comma-separated Discord user ids of the admins who get the Approve / Deny DM for pending requests and may use
# its buttons. Each must also be a league admin in the app. Leave empty to turn the DMs off.
NETBIRD_ADMIN_DISCORD_IDS=
# -----------------------------------------------------------------------------
