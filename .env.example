# Copy to `.env.local` for local dev (never commit real secrets).
# Production: set the same keys in Vercel → Project → Settings → Environment Variables.

# -----------------------------------------------------------------------------
# Ops alerts (optional) — fired on coach application updates and draft governance events.
# If both are unset, `notifyOpsEvent` in lib/ops-alerts.ts does nothing (no outbound HTTP).
#
# You must supply real URLs yourself (n8n Webhook node, or any HTTPS endpoint that
# forwards to Discord / OpenClaw / etc.). Do not commit live URLs with secrets in paths.
#
# N8N_WEBHOOK_URL=
# Example: https://aab-n8n.moodmnky.com/webhook/<webhook-id>
# In n8n: workflow must be ACTIVE; Webhook node HTTP method must be POST (app sends JSON).
#
# OPENCLAW_ALERT_WEBHOOK_URL=
# Optional second sink: e.g. small bridge that posts to a staff channel or OpenClaw.
# Not the OpenClaw MCP gateway URL — a plain POST webhook you control.
#
# Payload (JSON POST): { event, source: "poke-mnky", ts, ... }
# Events: coach_application_status, draft_session_pending_admin_approval,
#         draft_session_governance_approved
# -----------------------------------------------------------------------------

N8N_WEBHOOK_URL=
OPENCLAW_ALERT_WEBHOOK_URL=

# League sheet sync (names only; set values in Vercel, never commit them).
# Share the sheet with the service account email as a viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
CRON_SECRET=

# -----------------------------------------------------------------------------
# In-app AI (OpenClaw gateway — primary when set)
# OPENCLAW_GATEWAY_URL=wss://aab-openclaw.moodmnky.com
# OPENCLAW_GATEWAY_TOKEN=   # gateway.auth.token (operator.write), NOT hooks.token / OPENCLAW_HOOKS_TOKEN
# OPENCLAW_AGENT_ID=poke-mnky
# OPENCLAW_CLIENT_ID=webchat-ui
# OPENCLAW_CLIENT_MODE=webchat
# (gateway-client + backend works for /api/openclaw/health only — not chat.send)
# OPENCLAW_GATEWAY_INSECURE_SKIP_TLS_VERIFY=true   # local dev only (Norton/SSL inspection)
# AI_CHAT_PROVIDER=openclaw   # force OpenClaw; omit or openai to allow OpenAI fallback when gateway unset
# OPENCLAW_HTTP_CHAT=false    # default: use HTTPS /v1/chat/completions (recommended; avoids WS scope issues)
# Debug: GET /api/openclaw/health
#
# MCP tool mode for in-app assistants (draft pool MCP). Default OFF.
# Set true only when MCP_DRAFT_POOL_SERVER_URL + MCP_API_KEY are configured.
AI_MCP_TOOLS_ENABLED=
MCP_DRAFT_POOL_SERVER_URL=
MCP_API_KEY=
# -----------------------------------------------------------------------------

# Legacy Notion draft sync after each pick (off by default). In-app ops: docs/DRAFT-IN-APP-OPERATIONS.md
# DRAFT_PUSH_TO_NOTION=true

# Discord bot → app match submit (parse-result) without user session
# DISCORD_BOT_INTERNAL_SECRET=generate-a-long-random-string
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_RESULTS_CHANNEL_ID=
# DISCORD_VIDEO_CHANNEL_ID=
# DISCORD_RECAP_CHANNEL_ID=
# DISCORD_MOD_CHANNEL_ID=
# DISCORD_MOD_DIGEST_ENABLED=false

# -----------------------------------------------------------------------------
# Legacy Mock Draft Demo /admin/simulation writers (first cutover gate)
# Default OFF / unset = fail closed (HTTP 410) before any DB write.
# Do NOT set true in ordinary production deploys. Coordinator-approved emergency only.
# SIM_LEGACY_SIMULATION_WRITES=
# Optional n8n→full-run key (auth only; gate still applies first):
# SIMULATION_API_KEY=
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Showdown identity (Phase 0) — server-only (never NEXT_PUBLIC_*)
# Legacy parallel loginserver auto-registration — default OFF (HTTP 410).
# Does NOT verify central Main accounts or import teams. Coordinator-only re-enable.
# SHOWDOWN_LEGACY_LOGINSERVER_SYNC=
# Central OAuth client id (Phase 2). Alone does NOT enable linking; code gate
# SHOWDOWN_OAUTH_LINK_IMPLEMENTED must also be true after OAuth routes ship.
# SHOWDOWN_OAUTH_CLIENT_ID=
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Cursor: poke-mnky-n8n MCP (workflow list/get/edit — NOT the webhook above)
# Create a key in n8n: Settings → API → Create API Key.
# Point `.cursor/mcp.json` at these via "env": { "N8N_API_KEY": "${env:N8N_API_KEY}", ... }
# Restart Cursor after changing MCP env.
#
# N8N_API_URL=https://aab-n8n.moodmnky.com
# N8N_API_KEY=n8n_api_...
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Jev pilot (TypeSafe System One) — offline harness only (pnpm jev:pilot).
# Provider preference when credentials present: Vercel AI Gateway → OpenRouter → TypeSafe.
# Empty values only; never commit secrets.
#
# (1) Vercel AI Gateway — https://ai-gateway.vercel.sh/typesafe — model typesafe-ai/jev
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # set automatically on Vercel; local via `vercel env pull`
# (2) OpenRouter — https://openrouter.ai/api (/v1/systemone) — model typesafe/jev-1.13
OPENROUTER_API_KEY=
# (3) TypeSafe direct — https://api.typesafe.ai (/v1/systemone) — model jev-1.13.0
TYPESAFE_API_KEY=
# Legacy alias for TypeSafe direct (optional):
# JEV_API_KEY=
# Optional overrides:
# JEV_PROVIDER=vercel-ai-gateway
# JEV_MODEL=
# JEV_BASE_URL=
# App util lib/ai/jev.ts (NOT wired to live routes):
JEV_FLAGS_ENABLED=
# -----------------------------------------------------------------------------
